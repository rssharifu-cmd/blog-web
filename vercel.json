{
  "rewrites": [
    { "source": "/post-sitemap.xml", "destination": "/api/post-sitemap" },
    { "source": "/page-sitemap.xml", "destination": "/api/page-sitemap" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
